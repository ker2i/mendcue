# MendCue environment template. Copy to .env and fill in real values.
# This template targets Docker Compose (web + worker + postgres + caddy).
# For local no-database development, use README's local demo command instead.
APP_BASE_URL=https://intake.example.com
DOMAIN=intake.example.com
PORT=3000
POSTGRES_PASSWORD=replace_with_random_hex
# Compose supplies each service's database URL. Native Node operators must set
# DATABASE_URL separately; see docs/deployment.md.
# Web/worker use the restricted app_runtime role; migrate/seed use the owner.
APP_RUNTIME_PASSWORD=replace_with_random_hex
MODEL_PROVIDER=fixture
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_MS=25000
SESSION_SECRET=
SECRET_ENCRYPTION_KEY=
MEDIA_STORAGE_PATH=/data/media
# Queued turns: web enqueues, worker processes. Local single-process mode
# overrides this to SYNC_TURNS=1 (see README).
SYNC_TURNS=0
# Single-host shared ledger; unknown usage blocks further calls pending reconciliation.
GLOBAL_AI_SPEND_LIMIT=2
META_USAGE_LEDGER=/data/media/meta-usage.json
META_CASE_CALL_LIMIT=30
META_CASE_USD_LIMIT=0.5
META_PRICE_EFFECTIVE_DATE=2026-10-29
META_INPUT_USD_PER_MILLION=1.25
META_OUTPUT_USD_PER_MILLION=4.25
# Effective price date: 2026-10-29; estimates, not invoices.
# Enable only after reviewing actual image billing/reservations for your account.
META_IMAGE_BILLING_REVIEWED=0
NODE_ENV=production
# Production requires explicit MODEL_PROVIDER, PostgreSQL, HTTPS APP_BASE_URL,
# non-placeholder >=32-character secrets, and absolute persistent media/ledger paths.
# Intentional production fixture demos still require all persistence/secrets above.
# Optional SMTP notification channel. Credentials are server-side only.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional tenant-scoped operator exports; worker expires recognized exports after logDays.
# Point comparison runs to this same root. Never place the usage ledger inside it.
PRIVATE_ARTIFACT_ROOT=/data/media/operator-artifacts

# Technician Android home-screen app. Keep one private VAPID key pair across restarts.
PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com
