# MendCue environment template. Copy to .env and fill in real values.
# This template targets Docker Compose (web + worker + postgres + caddy).
# For local no-database development, see README "Local modes".
APP_BASE_URL=http://localhost:3000
DOMAIN=localhost
PORT=3000
POSTGRES_PASSWORD=intake_change_me
DATABASE_URL=postgres://intake:intake_change_me@postgres:5432/intake
# Owner URL above is for migrate/seed only. Web/worker connect as the
# restricted app_runtime role (see docs/deployment.md "Database roles").
APP_RUNTIME_PASSWORD=change_me_in_production
MODEL_PROVIDER=fixture
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_MS=25000
SESSION_SECRET=change_me_32plus_chars_minimum
SECRET_ENCRYPTION_KEY=change_me_32plus_chars_minimum
MEDIA_STORAGE_PATH=/data/media
# Queued turns: web enqueues, worker processes. Local single-process mode
# overrides this to SYNC_TURNS=1 (see README).
SYNC_TURNS=0
# Spending: NOT ENFORCED by the application yet. Do not expose live-model
# traffic publicly without an external budget control. See docs/deployment.md.
# GLOBAL_AI_SPEND_LIMIT is reserved for the future spend guard.
NODE_ENV=production
