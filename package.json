{
  "name": "mendcue",
  "version": "0.1.0",
  "private": true,
  "description": "Tenant-aware appliance service intake platform (hackathon scope)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/server/ui && cp src/server/ui/app.css src/server/ui/*.js dist/server/ui/",
    "start": "node dist/server/index.js",
    "dev": "npm run build && node dist/server/index.js",
    "worker": "node dist/worker/index.js",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "puppeteer-core": "^24.43.1",
    "supertest": "^7.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
